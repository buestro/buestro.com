---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Card — Buestro"
  description="A beautiful, themeable personal profile page. Edit one config file, deploy anywhere."
>
  <!-- ── Header ── -->
  <header class="site-header">
    <div class="container">
      <a href="/" class="wordmark" aria-label="Buestro home">
        <span class="wordmark-bar" aria-hidden="true"></span>
        <span class="wordmark-text">buestro</span>
      </a>
    </div>
  </header>

  <!-- ── Main ── -->
  <main class="main">
    <div class="container">
      <p class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        Free — available now
      </p>
      <h1 class="page-title">Card</h1>
      <p class="lead">
        A beautiful, themeable personal profile page. Edit one config file, deploy anywhere.
        No HTML, no CSS required.
      </p>

      <div class="actions">
        <a
          href="https://card.buestro.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          View live demo
        </a>
        <a
          href="https://github.com/buestro/card"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          GitHub
        </a>
      </div>

      <ul class="features">
        <li>Edit a single <code>profile.config.ts</code> — no HTML or CSS required</li>
        <li>Carbon Mint theme with automatic dark / light mode</li>
        <li>12 social platform icons built in</li>
        <li>Zero client-side JavaScript</li>
        <li>Deploys in minutes to Vercel, Netlify, or Cloudflare Pages</li>
        <li>MIT licensed — free for personal and commercial use</li>
      </ul>
    </div>
  </main>

  <!-- ── Footer ── -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-brand">
        <span class="footer-bar" aria-hidden="true"></span>
        buestro
      </span>
      <nav class="footer-links" aria-label="Footer links">
        <a href="https://x.com/buestrodev" target="_blank" rel="noopener noreferrer">X / Twitter</a>
        <a href="https://github.com/buestro" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:hello@buestro.com">hello@buestro.com</a>
        <a href="/terms">Terms</a>
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Buestro. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .container {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ── Header ── */
  .site-header {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border-default);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .wordmark-bar {
    display: block;
    width: 4px;
    height: 22px;
    background: var(--accent);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .wordmark-text {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* ── Content ── */
  .main {
    flex: 1;
    padding-block: 4rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent-text);
    background: var(--accent-subtle);
    border: 1px solid var(--accent-muted);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    margin: 0 0 1.5rem;
  }

  .badge-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .page-title {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .lead {
    margin: 0 0 2rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .btn-secondary:hover {
    border-color: var(--accent);
  }

  .features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border-default);
  }

  .features li {
    padding-block: 0.875rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-default);
    padding-left: 1.25rem;
    position: relative;
  }

  .features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  .features code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875em;
    background: var(--accent-subtle);
    color: var(--accent-text);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
  }

  /* ── Footer ── */
  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid var(--border-default);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .footer-bar {
    display: block;
    width: 3px;
    height: 16px;
    background: var(--accent);
    border-radius: 2px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-copy {
    width: 100%;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
