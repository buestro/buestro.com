---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <!-- ── Site header ── -->
  <header class="site-header">
    <div class="container">
      <a href="/" class="wordmark" aria-label="Buestro home">
        <span class="wordmark-bar" aria-hidden="true"></span>
        <span class="wordmark-text">buestro</span>
      </a>
    </div>
  </header>

  <!-- ── Main ── -->
  <main class="main">
    <div class="container hero">

      <!-- Badge -->
      <p class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        Coming soon
      </p>

      <!-- Headline -->
      <h1 class="headline">
        Production-grade Astro templates<br class="break" />
        for builders.
      </h1>

      <!-- Subheadline -->
      <p class="subheadline">
        Ship faster with premium Astro templates built for speed, quality,
        and real-world use. No bloat. Just code that works.
      </p>

      <!-- Email capture -->
      <form
        class="capture-form"
        action={`https://app.kit.com/forms/9413743/subscriptions`}
        method="post"
        target="_blank"
      >
        <label for="email" class="sr-only">Email address</label>
        <input
          id="email"
          type="email"
          name="email_address"
          placeholder="you@example.com"
          required
          autocomplete="email"
          class="email-input"
        />
        <button type="submit" class="submit-btn">
          Join the waitlist
        </button>
      </form>

      <p class="privacy-note">No spam. Unsubscribe at any time.</p>

      <!-- Products preview -->
      <div class="products-row">
        <div class="product-chip">
          <span class="chip-dot" aria-hidden="true"></span>
          Card — free personal profile page
        </div>
        <div class="product-chip chip-muted">
          Launchpad — coming Q3 2026
        </div>
      </div>
    </div>
  </main>

  <!-- ── Footer ── -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-brand">
        <span class="footer-bar" aria-hidden="true"></span>
        buestro
      </span>
      <nav class="footer-links" aria-label="Footer links">
        <a href="/card">Card</a>
        <a href="/blog">Blog</a>
        <a href="https://x.com/buestrodev" target="_blank" rel="noopener noreferrer">X / Twitter</a>
        <a href="https://github.com/buestro" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:hello@buestro.com">hello@buestro.com</a>
        <a href="/terms">Terms</a>
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Buestro. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ── Layout ── */
  .container {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ── Header ── */
  .site-header {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border-default);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .wordmark-bar {
    display: block;
    width: 4px;
    height: 22px;
    background: var(--accent);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .wordmark-text {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* ── Hero ── */
  .main {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: 6rem 4rem;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  /* Badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent-text);
    background: var(--accent-subtle);
    border: 1px solid var(--accent-muted);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    margin: 0 0 1.75rem;
  }

  .badge-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Headline */
  .headline {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .break { display: none; }
  @media (min-width: 540px) { .break { display: block; } }

  /* Subheadline */
  .subheadline {
    margin: 0 0 2rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 520px;
  }

  /* Form */
  .capture-form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    max-width: 480px;
    flex-wrap: wrap;
  }

  .email-input {
    flex: 1;
    min-width: 0;
    padding: 0.625rem 0.875rem;
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color 0.15s;
  }

  .email-input::placeholder {
    color: var(--text-muted);
  }

  .email-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .submit-btn {
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-family: inherit;
    font-weight: 600;
    color: #ffffff;
    background: var(--accent);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .submit-btn:hover {
    background: var(--accent-hover);
  }

  /* Privacy note */
  .privacy-note {
    margin: 0.75rem 0 2.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Products row */
  .products-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .product-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
  }

  .chip-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .chip-muted {
    color: var(--text-muted);
  }

  /* ── Footer ── */
  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid var(--border-default);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .footer-bar {
    display: block;
    width: 3px;
    height: 16px;
    background: var(--accent);
    border-radius: 2px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-copy {
    width: 100%;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
