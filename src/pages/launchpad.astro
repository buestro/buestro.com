---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Launchpad — Buestro"
  description="A complete Astro starter kit for launching products fast. Coming Q3 2026."
>
  <!-- ── Header ── -->
  <header class="site-header">
    <div class="container">
      <a href="/" class="wordmark" aria-label="Buestro home">
        <span class="wordmark-bar" aria-hidden="true"></span>
        <span class="wordmark-text">buestro</span>
      </a>
    </div>
  </header>

  <!-- ── Main ── -->
  <main class="main">
    <div class="container">
      <p class="badge">Coming Q3 2026</p>
      <h1 class="page-title">Launchpad</h1>
      <p class="lead">
        A complete Astro starter kit built for launching products fast. Authentication,
        payments, blog, and docs — all wired up and ready to ship.
      </p>
      <p class="cta-note">
        Get notified when it launches — <a href="/#waitlist">join the waitlist</a>.
      </p>
    </div>
  </main>

  <!-- ── Footer ── -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="footer-brand">
        <span class="footer-bar" aria-hidden="true"></span>
        buestro
      </span>
      <nav class="footer-links" aria-label="Footer links">
        <a href="https://x.com/buestrodev" target="_blank" rel="noopener noreferrer">X / Twitter</a>
        <a href="https://github.com/buestro" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:hello@buestro.com">hello@buestro.com</a>
        <a href="/terms">Terms</a>
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Buestro. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .container {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ── Header ── */
  .site-header {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border-default);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .wordmark-bar {
    display: block;
    width: 4px;
    height: 22px;
    background: var(--accent);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .wordmark-text {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* ── Content ── */
  .main {
    flex: 1;
    padding-block: 4rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    margin: 0 0 1.5rem;
  }

  .page-title {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .lead {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .cta-note {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .cta-note a {
    color: var(--accent);
    text-decoration: none;
  }

  .cta-note a:hover {
    text-decoration: underline;
  }

  /* ── Footer ── */
  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid var(--border-default);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .footer-bar {
    display: block;
    width: 3px;
    height: 16px;
    background: var(--accent);
    border-radius: 2px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-copy {
    width: 100%;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
